{
  "extends": "common.json",
  "case_id": "short-sale",
  "positions": [
    {
      "id": "borrowed-Q",
      "account": "A",
      "commodity": "Q",
      "kind": "claim",
      "counterparty": "lender",
      "measurement": "cost",
      "inventory": "individual",
      "booking": "@declaration:short-book"
    }
  ],
  "policies": [
    {
      "id": "short-book",
      "kind": "booking",
      "payload": {
        "position_ids": [
          "@borrowed-Q"
        ],
        "method": "FIFO",
        "acquisition_date_role": "traded",
        "tie_break": "origin_key",
        "fee_attribution_declaration_id": "@declaration:fees",
        "rounding": {
          "scale": 2,
          "mode": "half_even",
          "residual": "final_slice"
        }
      }
    }
  ],
  "oracle_notes": [
    "Borrowed security obligation is negative two Q/principal -20, distinct from proceeds +20 cash. Cover one Q at 12 releases principal 10 and incurs book loss 2.",
    "Borrow fee 1 and substitute dividend 3 are distinct expenses, neither added to the short principal. Remaining obligation is one Q/principal -10; cash 20-1-3-12=4."
  ],
  "expected_answers": {
    "inventory": {
      "borrowed-Q": {
        "units": "-1",
        "principal": "-10"
      }
    },
    "positions": {
      "cash-A": "4"
    },
    "cover_loss": "2",
    "borrow_fee": "1",
    "substitute_dividend": "3"
  },
  "negative_cases": [
    {
      "id": "close-negative-as-positive",
      "mutation": "short_sign",
      "owner": "inventory-replay",
      "expected": "source-sign"
    },
    {
      "id": "borrow-fee-netted",
      "mutation": "fee_principal",
      "owner": "component-ownership",
      "expected": "fee-distinct"
    }
  ],
