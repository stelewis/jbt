{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "text_semantics",
    "foreign_keys",
    "numeric_limits",
    "bundles",
    "tables",
    "enums"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "text_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "decimal_coefficient",
        "bundles",
        "tables"
      ],
      "properties": {
        "entity_id": {
          "const": "identifier"
        },
        "decimal_coefficient": {
          "const": "identifier"
        },
        "bundles": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dates",
            "date_modes",
            "time"
          ],
          "properties": {
            "dates": {
              "$ref": "#/$defs/text_semantics"
            },
            "date_modes": {
              "$ref": "#/$defs/text_semantics"
            },
            "time": {
              "$ref": "#/$defs/text_semantics"
            }
          }
        },
        "tables": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/text_semantics"
          }
        }
      }
    },
    "foreign_keys": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "$ref": "#/$defs/name"
        },
        "additionalProperties": {
          "$ref": "#/$defs/name"
        }
      }
    },
    "numeric_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coefficient_digits",
        "scale",
        "source_scale",
        "intermediate_digits",
        "intermediate_scale"
      ],
      "properties": {
        "coefficient_digits": {
          "const": 96
        },
        "scale": {
          "const": 38
        },
        "source_scale": {
          "const": 38
        },
        "intermediate_digits": {
          "const": 384
        },
        "intermediate_scale": {
          "const": 152
        }
      }
    },
    "bundles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dates",
        "date_modes",
        "time"
      ],
      "properties": {
        "dates": {
          "$ref": "#/$defs/fields"
        },
        "date_modes": {
          "$ref": "#/$defs/fields"
        },
        "time": {
          "$ref": "#/$defs/fields"
        }
      }
    },
    "tables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "primary_key",
          "fields"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/name"
          },
          "primary_key": {
            "$ref": "#/$defs/names"
          },
          "sort_key": {
            "$ref": "#/$defs/names"
          },
          "unique": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/names"
            }
          },
          "bundles": {
            "type": "array",
            "items": {
              "enum": [
                "dates",
                "date_modes",
                "time"
              ]
            },
            "uniqueItems": true
          },
          "fields": {
            "$ref": "#/$defs/fields"
          }
        }
      }
    },
    "enums": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z_]+\\.[a-z_]+$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z_]+$"
    },
    "names": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/name"
      },
      "uniqueItems": true
    },
    "text_semantics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identifier": {
          "$ref": "#/$defs/names"
        },
        "descriptive": {
          "$ref": "#/$defs/names"
        }
      }
    },
    "fields": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "enum": [
          "string",
          "string?",
          "integer",
          "integer?",
          "boolean",
          "boolean?",
          "date",
          "date?",
          "list",
          "decimal",
          "decimal?"
        ]
      }
    }
  }
}
